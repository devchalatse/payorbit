# Copy to .env for local Docker Compose development. Never commit real secrets.
APP_ENV=development
API_PORT=8000
POSTGRES_DB=payorbit
POSTGRES_USER=payorbit
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://payorbit:change-this-local-db-password@db:5432/payorbit
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-unique-random-secret-at-least-32-characters
